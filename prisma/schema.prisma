generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id               String            @id @default(cuid())
  account          String            @unique
  password         String
  name             String
  phone            String?
  email            String?
  status           String            @default("active")
  planType         String?
  remainingClasses Int               @default(0)
  planStartDate    DateTime?
  planEndDate      DateTime?
  classId1         String?
  classId2         String?
  classId3         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookings         Booking[]
  enrollments      ClassEnrollment[]
  leaves           Leave[]
  makeups          Makeup[]
  class3           Class?            @relation("MemberClass3", fields: [classId3], references: [id])
  class2           Class?            @relation("MemberClass2", fields: [classId2], references: [id])
  class1           Class?            @relation("MemberClass1", fields: [classId1], references: [id])
}

model Leave {
  id          String    @id @default(cuid())
  memberId    String
  classId     String?
  classDate   DateTime
  className   String
  instructor  String?
  status      String    @default("pending")
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  class       Class?    @relation(fields: [classId], references: [id])
  makeups     Makeup[]
}

model Makeup {
  id          String    @id @default(cuid())
  memberId    String
  leaveId     String?
  classId     String?
  classDate   DateTime
  className   String
  instructor  String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  leave       Leave?    @relation(fields: [leaveId], references: [id])
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  class       Class?    @relation("MakeupClass", fields: [classId], references: [id])
}

model Class {
  id               String            @id @default(cuid())
  name             String
  instructor       String
  date             DateTime
  startTime        String
  endTime          String
  room             String?
  capacity         Int               @default(20)
  enrolled         Int               @default(0)
  status           String            @default("active")
  isRecurring      Boolean           @default(false)
  recurringPattern String?
  recurringEndDate DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  enrollments      ClassEnrollment[]
  members3         Member[]          @relation("MemberClass3")
  members2         Member[]          @relation("MemberClass2")
  members1         Member[]          @relation("MemberClass1")
  leaves           Leave[]
  makeups          Makeup[]          @relation("MakeupClass")
}

model ClassEnrollment {
  id         String   @id @default(cuid())
  memberId   String
  classId    String
  enrolledAt DateTime @default(now())
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, classId])
}

model Booking {
  id        String   @id @default(cuid())
  memberId  String?
  name      String
  phone     String
  email     String?
  classDate DateTime
  className String?
  notes     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member?  @relation(fields: [memberId], references: [id])
}

model Contact {
  id            String   @id @default(cuid())
  studioName    String
  address       String
  phone         String?
  email         String?
  businessHours String
  parkingInfo   String?
  mapUrl        String?
  facebookUrl   String?
  instagramUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
